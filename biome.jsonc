{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/generated",
      "!packages/contracts/types",
      "!packages/contracts/artifacts",
      "!packages/contracts/cache",
      "!backlog",
      "!docs",
      // CSS linting / Tailwind v4 parsing is out of scope here (TS packages only);
      // it needs its own ticket.
      "!**/*.css",
      // Brand over lint: the logo files come from the brand kit unmodified
      // (see packages/frontend/src/assets/brand/README.md) and must stay
      // byte-identical. Biome would demand a11y titles inside them — an edit to
      // a brand file that the usage rules forbid. The alt text lives on the
      // <img> tags in brand-logo.tsx instead.
      "!packages/frontend/src/assets/brand/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {
    "parser": {
      // backend (NestJS) uses legacy parameter decorators (@Body(), @Param(), ...),
      // enabled project-wide via tsconfig `experimentalDecorators` — Biome treats the
      // syntax as "unsafe" by default; this repo relies on it deliberately.
      // (Scoping per overrides auf packages/backend wurde probiert und revertiert:
      // ein Override-Match ändert die Regel-Auswertung der Backend-Dateien —
      // useNodejsImportProtocol feuert dann neu. Global bleibt der pragmatische Stand.)
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
